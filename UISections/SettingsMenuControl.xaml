<UserControl x:Class="Aimmy2.Controls.SettingsMenuControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="clr-namespace:Aimmy2.UILibrary"
             mc:Ignorable="d">
    <ScrollViewer x:Name="SettingsMenu"
                  VerticalScrollBarVisibility="Auto"
                  PanningMode="VerticalOnly">
        <StackPanel>
            <TextBlock x:Name="ErrorText" 
                       Foreground="#FF5555" 
                       TextWrapping="Wrap" 
                       Margin="15,10" 
                       Visibility="Collapsed" 
                       FontSize="13" 
                       FontWeight="SemiBold"
                       FontFamily="Segoe UI Semibold"/>
            <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="SSP1"
                        Grid.Column="0"
                        Margin="5,0,10,0">
                <StackPanel x:Name="SettingsConfig" />
                <StackPanel x:Name="DisplaySelectMenu" />
                <StackPanel x:Name="ThemeMenu" />
            </StackPanel>
            <StackPanel x:Name="SSP2"
                        Grid.Column="1"
                        Margin="5,0,10,0">
                <StackPanel x:Name="ModelSettingsSlot1" />
                <StackPanel x:Name="ModelSettingsSlot2" />
                <StackPanel x:Name="ModelSettingsGeneral" />
            </StackPanel>
        </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>