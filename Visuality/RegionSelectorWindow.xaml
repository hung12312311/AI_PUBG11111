<Window x:Class="Visuality.RegionSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Region Selector"
        WindowState="Maximized"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#55000000"
        Topmost="True"
        Cursor="Cross">
    <Grid>
        <Canvas x:Name="SelectionCanvas" Background="Transparent" MouseDown="SelectionCanvas_MouseDown" MouseMove="SelectionCanvas_MouseMove" MouseUp="SelectionCanvas_MouseUp">
            <Rectangle x:Name="SelectionRect" Stroke="Red" StrokeThickness="2" Fill="#55FF0000" Visibility="Collapsed" IsHitTestVisible="False"/>
            <StackPanel Canvas.Left="10" Canvas.Top="10" IsHitTestVisible="False">
                <TextBlock x:Name="TitleText" Foreground="#00FF00" FontSize="26" FontWeight="Bold" Text="Select Region" Margin="0,0,0,5" Effect="{DynamicResource ShadowEffect}"/>
                <TextBlock x:Name="InfoText" Foreground="White" FontSize="16" Text="Click and drag to select a region. Press ESC to cancel."/>
            </StackPanel>
            
            <Grid x:Name="ConfirmPanel" Visibility="Collapsed" Background="#CC000000" Width="300" Height="150" Canvas.Left="100" Canvas.Top="100">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Xác nhận vùng chọn?" Foreground="White" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Có (Yes)" Width="80" Height="30" Margin="10" Click="Confirm_Click" Background="#FF722ED1" Foreground="White" BorderThickness="0"/>
                        <Button Content="Thử lại" Width="80" Height="30" Margin="10" Click="Retry_Click" Background="#FF444444" Foreground="White" BorderThickness="0"/>
                        <Button Content="Hủy" Width="80" Height="30" Margin="10" Click="Cancel_Click" Background="#FF444444" Foreground="White" BorderThickness="0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Canvas>
    </Grid>
</Window>
